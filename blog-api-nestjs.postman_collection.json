        "url": {
          "raw": "{{base_url}}/posts/{{postId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "Delete post",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/{{postId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "Create comment",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Ótimo post!\",\n  \"postId\": {{postId}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/comments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "comments"
          ]
        }
