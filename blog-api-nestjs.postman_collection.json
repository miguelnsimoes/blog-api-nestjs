          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "Update post",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
